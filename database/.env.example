# DarkTrace — database environment (copy to database/.env, never commit .env)
# Backend .env stays separate (backend/.env.example) — these values must match it.
# Development defaults only. Change every password before any shared/production use.

# PostgreSQL (SQL store: users, sources, crawl jobs, cases, investigations, evidence)
DATABASE_URL=postgresql://postgres:darktrace-dev@localhost:5432/darktrace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=darktrace-dev
POSTGRES_DB=darktrace
POSTGRES_PORT=5432

# MongoDB (NoSQL store: threats, indicators, alerts, crawled docs, activity, SIEM, crawl logs)
MONGO_URL=mongodb://root:darktrace-dev@localhost:27017/darktrace?authSource=admin
MONGO_USER=root
MONGO_PASSWORD=darktrace-dev
MONGO_DB=darktrace
MONGO_PORT=27017

# Redis (kept in docker-compose.yml, but nothing in the backend uses it
# since the dev backend moved alerts to MongoDB; remove if unneeded)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
