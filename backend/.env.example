# Copy to .env and fill in only the values needed by the service you run.
# NEVER commit .env to git.
# Development API (dev_server.py) needs all three: PostgreSQL for users /
# sources / crawl jobs / cases / revoked tokens, MongoDB for alerts /
# threats, and a JWT secret. Start both databases with:
#   docker compose -f ../database/docker-compose.yml up -d
# Redis is no longer used by the dev backend.

# PostgreSQL — Railway: Postgres service -> Variables/Connect -> copy "DATABASE_PUBLIC_URL"
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# MongoDB — local: mongodb://localhost:27017 (database "darktrace" by default)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=darktrace

# 32+ random characters; generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=darktrace
